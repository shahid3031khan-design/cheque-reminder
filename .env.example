# Copy this file to .env and fill in your own values. Never commit the real .env file.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name to use inside your MongoDB cluster
MONGODB_DB=cheque_reminder

# Port the server listens on (hosting platforms usually set this for you)
PORT=8743
